BLOOMBOX_RUNTIME_MODE=preview
BLOOMBOX_CHECKOUT_PROVIDER=preview
BLOOMBOX_PUBLIC_ORIGIN=http://localhost:3000

SHOPIFY_STORE_DOMAIN=example.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=replace-in-secret-manager
SHOPIFY_CATALOG_TAG=bloombox

DATABASE_URL=postgres://application-role:replace@localhost:5432/bloombox
DATABASE_WORKER_URL=postgres://worker-role:replace@localhost:5432/bloombox
DATABASE_SSL_MODE=disable
DATABASE_MAX_CONNECTIONS=5
BLOOMBOX_PII_KEYRING={"activeKeyId":"v1","keys":{"v1":"replace-with-32-byte-base64-key"}}

STRIPE_MODE=test
STRIPE_CHECKOUT_SECRET_KEY=rk_test_replace
STRIPE_RECONCILIATION_SECRET_KEY=rk_test_replace_with_a_different_key
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_ACCOUNT_ID=acct_replace
STRIPE_SHIPPING_RATE_ID=shr_replace
STRIPE_TAX_BEHAVIOR=unspecified
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_TERMS_ACCEPTANCE=none
# STRIPE_CHECKOUT_CUSTOM_DOMAIN=pay.example.com

COMMERCE_WORKER_SECRET=replace-with-at-least-32-random-characters
