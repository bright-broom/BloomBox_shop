# Preview is the safe default. Production mode requires durable provider adapters.
BLOOMBOX_RUNTIME_MODE=preview

# Use separate least-privilege URLs for application and asynchronous worker processes.
DATABASE_URL=postgres://bloombox_application:replace-me@localhost:5432/bloombox
DATABASE_WORKER_URL=postgres://bloombox_worker:replace-me@localhost:5432/bloombox
# Used only by the protected release workflow and never by the application runtime.
DATABASE_MIGRATION_URL=postgres://bloombox_migration:replace-me@localhost:5432/bloombox
DATABASE_SSL_MODE=verify-full
DATABASE_MAX_CONNECTIONS=5

# JSON keyring for AES-256-GCM. Values must be base64-encoded 32-byte keys.
# Keep previous keys during rotation so retained data remains decryptable.
BLOOMBOX_PII_KEYRING={"activeKeyId":"replace-me","keys":{"replace-me":"replace-with-base64-key"}}
